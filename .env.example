# Supabase — public (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — private (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MoonPay
NEXT_PUBLIC_MOONPAY_API_KEY=pk_test_...
MOONPAY_SECRET_KEY=sk_test_...
MOONPAY_WEBHOOK_KEY=wk_test_...

# Crypto wallet addresses (used as MoonPay destination wallets)
NEXT_PUBLIC_USDT_WALLET_ADDRESS=
NEXT_PUBLIC_BTC_WALLET_ADDRESS=
NEXT_PUBLIC_ETH_WALLET_ADDRESS=

# Coinbase Commerce (server-side only)
COINBASE_COMMERCE_API_KEY=your-api-key
COINBASE_COMMERCE_WEBHOOK_SECRET=your-webhook-secret

# Sentry (optional)
SENTRY_DSN=https://...@sentry.io/...
